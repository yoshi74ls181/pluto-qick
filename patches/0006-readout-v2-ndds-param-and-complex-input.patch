-// Number of parallel dds blocks.
-localparam [15:0] N_DDS = 8;
-
+// Number of parallel dds blocks. NOTE: fir_compiler_0 must be regenerated to
+// match -- its Output_Sample_Period is the decimation rate divided by N_DDS.
+// The copy shipped here is built for N_DDS=1 (SamplePeriod 8).
+parameter [15:0] N_DDS = 1;
+
+// "REAL" is upstream: a real ADC stream mixed against the DDS. "COMPLEX" takes
+// an already quadrature-downconverted {Q,I} stream, as an AD9361 delivers.
+parameter INPUT_TYPE = "COMPLEX";
+localparam IN_W = (INPUT_TYPE == "COMPLEX") ? 32 : 16;
 /*********/
 /* Ports */
 /*********/
@@ -43,7 +49,7 @@ input						aclk;
 
 output						s_axis_tready;
 input						s_axis_tvalid;
-input		[N_DDS*16-1:0]	s_axis_tdata;
+input		[N_DDS*IN_W-1:0]	s_axis_tdata;
 
 input						m0_axis_tready;
 output						m0_axis_tvalid;
@@ -89,6 +95,10 @@ synchronizer_n
 
 // Down-conversion + Filter +  Decimation.
 down_conversion_fir
+	#(
+		.N_DDS		(N_DDS		),
+		.INPUT_TYPE	(INPUT_TYPE	)
+	)
 	down_conversion_fir_i
