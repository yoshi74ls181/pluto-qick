+// "REAL" is upstream: a real ADC stream mixed against the DDS. "COMPLEX" takes
+// an already quadrature-downconverted {Q,I} stream, as an AD9361 delivers.
+parameter INPUT_TYPE = "COMPLEX";
+localparam IN_W = (INPUT_TYPE == "COMPLEX") ? 32 : 16;
 /*********/
 /* Ports */
 /*********/
@@ -38,7 +44,7 @@ input						clk;
 
 output						s_axis_tready_o;
 input						s_axis_tvalid_i;
-input		[N_DDS*16-1:0]	s_axis_tdata_i;
+input		[N_DDS*IN_W-1:0]	s_axis_tdata_i;
 
 input						m0_axis_tready_i;
 output						m0_axis_tvalid_o;
@@ -62,7 +68,8 @@ input		[82:0]			fifo_dout_i;
 // Down-conversion block (product with fast DDS).
 down_conversion 
 	#(
-		.N_DDS	(N_DDS)
+		.N_DDS	(N_DDS),
+		.INPUT_TYPE (INPUT_TYPE)
 	)
 	down_conversion_i
 	(
